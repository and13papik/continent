# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated list of additional report destinations.
TELEGRAM_ALLOWED_CHAT_IDS=

# Server authentication / database access. Never prefix these with VITE_.
APP_ORIGIN=https://continental.monster
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly opt into background jobs on a persistent Express host only.
ENABLE_TELEGRAM_POLLING=false
ENABLE_TELEGRAM_SCHEDULE=false
ENABLE_LIVE_EVENT_CLEANUP=false

# OnlyMonster API Key & Base URL
ONLYMONSTER_API_KEY=
ONLYMONSTER_API_BASE_URL=https://omapi.onlymonster.ai/api/v0
